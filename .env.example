# Preencha localmente ou use scripts/fetch-env.sh quando a URL segura for fornecida.
DATABASE_URL=
# Banco descartável dos testes de integração; nunca o mesmo de DATABASE_URL.
TEST_DATABASE_URL=
JWT_SECRET_KEY=
# Validade do token em minutos; vazio usa 1440 (24 h, Regra 09).
JWT_EXPIRACAO_MIN=
# Origens do navegador liberadas no CORS (ex.: app Flutter web local); vazio desliga.
CORS_ORIGIN_REGEX=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
