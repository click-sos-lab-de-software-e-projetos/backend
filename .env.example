# .env único do projeto (backend, frontend e tela-consentimento). Copie para .env e preencha; nunca versione.
# Uso: scripts/run.sh local | dev  (ou scripts/run.sh shell local|dev|prod para comandos avulsos).
# Cada variável por perfil tem sufixo _LOCAL, _DEV ou _PROD; o script exporta a do perfil sem sufixo.
# Valores com & (URLs do Neon) precisam de aspas.

# ===== comuns a todos os perfis =====
JWT_SECRET_KEY=
# Validade do token em minutos; vazio usa 1440 (24 h, Regra 09).
JWT_EXPIRACAO_MIN=
# Banco descartável dos testes de integração; nunca o mesmo de DATABASE_URL.
TEST_DATABASE_URL=
USE_FAKE_API=false
# Referência: o build usa android/local.properties (Android) e web/index.html (web).
MAPS_API_KEY=
# URL segura usada por scripts/fetch-env.sh.
NEON_ENV_URL=

# ===== local: tudo na máquina (o run.sh sobe PostGIS e Evolution no Docker) =====
# Usuário, senha, porta e banco daqui viram o container clicksos-db.
DATABASE_URL_LOCAL=postgresql+psycopg://click_sos:click_sos@localhost:5432/click_sos
# Origens do navegador liberadas no CORS (tela-consentimento na 5500, app web na 5600).
CORS_ORIGIN_REGEX_LOCAL='^http://localhost:\d+$'
# Endereço da página tela-consentimento; o link enviado ao contato é <este endereço>#token=...
CONSENTIMENTO_URL_BASE_LOCAL=http://localhost:5500/
# Evolution API v2; a chave vira AUTHENTICATION_API_KEY do container (openssl rand -hex 32).
EVOLUTION_API_URL_LOCAL=http://localhost:8080
EVOLUTION_API_KEY_LOCAL=
EVOLUTION_INSTANCE_LOCAL=click-sos-dev
API_BASE_URL_LOCAL=http://localhost:8000/api/v1

# ===== dev: backend local + branch "dev" do Neon (nunca o neondb de produção) =====
DATABASE_URL_DEV=
CORS_ORIGIN_REGEX_DEV='^http://localhost:\d+$'
CONSENTIMENTO_URL_BASE_DEV=http://localhost:5500/
EVOLUTION_API_URL_DEV=
EVOLUTION_API_KEY_DEV=
EVOLUTION_INSTANCE_DEV=
API_BASE_URL_DEV=http://localhost:8000/api/v1

# ===== prod: Render + neondb (o run.sh só usa em "shell prod") =====
DATABASE_URL_PROD=
CORS_ORIGIN_REGEX_PROD=
CONSENTIMENTO_URL_BASE_PROD=
EVOLUTION_API_URL_PROD=
EVOLUTION_API_KEY_PROD=
EVOLUTION_INSTANCE_PROD=
API_BASE_URL_PROD=
